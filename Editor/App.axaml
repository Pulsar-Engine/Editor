<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Editeur.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <SimpleTheme />
    </Application.Styles>
    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryBackground" Color="#FF333333"/>
    </Application.Resources>
</Application>