<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulsarApp"
        xmlns:editeur="clr-namespace:Editeur"
        x:Class="PulsarApp.MainWindow"
        Title="Éditeur Neutron"
        Width="1200" Height="800">

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="5,2"/>
      <Setter Property="MinWidth" Value="70"/>
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="Padding" Value="5,2"/>
      <Setter Property="MinWidth" Value="70"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Fichier">
        <MenuItem Header="_Open..." Click="OnOpenFileClicked" />
        <Separator />
        <MenuItem Header="Ouvrir un dossier..." Click="OpenFolder"/>
        <Separator />
        <MenuItem Header="Quitter" Click="Exit"/>
      </MenuItem>
      <MenuItem Header="_Fenêtre">
        <MenuItem Header="✓ File Explorer" Click="ToggleFileExplorer"/>
        <MenuItem Header="✓ Editor" Click="ToggleEditor" x:Name="EditorMenuItem"/>
        <MenuItem Header="✓ Game View" Click="ToggleGameView"/>
        <MenuItem Header="✓ Console" Click="ToggleConsole"/>
      </MenuItem>
    </Menu>
    
    <Grid x:Name="MainGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="5" />
        <RowDefinition Height="250" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- File Explorer -->
      <Border Grid.Row="0" Grid.Column="0" x:Name="FileExplorerPanel" BorderBrush="Gray" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Background="#444">
            <TextBlock Text="Explorateur de fichiers" FontWeight="Bold"/>
            <Button Content="📁 Ouvrir un dossier" Click="OpenFolder" HorizontalAlignment="Left" Margin="0,5,0,0"/>
          </StackPanel>

          <TextBlock x:Name="NoFolderMessage"
                     Text="Aucun dossier ouvert"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Foreground="Gray"
                     FontStyle="Italic"
                     IsVisible="True"/>

          <TreeView x:Name="FileExplorerTree" IsVisible="False">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="{x:Type local:FileSystemItem}" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" />
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" Background="Gray"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

      <!-- Editor -->
      <Border Grid.Row="0" Grid.Column="2" x:Name="EditorPanel" BorderBrush="Gray" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
        
          <Border Grid.Row="0" Background="#EEE" Padding="5">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Button x:Name="SaveButton" Content="💾 Save" Click="SaveCurrentFile" 
                      ToolTip.Tip="Save current file (Ctrl+S)"/>
              <Button Content="🗑 Close" Click="CloseCurrentTab" 
                      ToolTip.Tip="Close current tab"/>
            </StackPanel>
          </Border>
        
          <TabControl x:Name="EditorTabs" Grid.Row="1">
            <TabItem Header="Bienvenue">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="Ouvrez un fichier en double-cliquant dans l'explorateur"
                           FontSize="16"
                           Padding="10"
                           TextWrapping="NoWrap" />
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="0" Grid.Column="3" Width="5" Background="Gray"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

      <!-- Game View -->
      <Border Grid.Row="0" Grid.Column="4" x:Name="GameViewPanel" BorderBrush="Gray" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          
          <Border Grid.Row="0" Background="#EEE" Padding="5">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Button Content="Sélectionner" ToolTip.Tip="Mode sélection (V)" 
                      Click="OnSelectToolClicked" x:Name="SelectToolButton"/>
              <Button Content="Déplacer" ToolTip.Tip="Mode déplacement (M)" 
                      Click="OnMoveToolClicked" x:Name="MoveToolButton"/>
              
              <Separator Margin="5,0"/>
              
              <Button Content="Dupliquer" ToolTip.Tip="Dupliquer l'objet (Ctrl+D)" 
                      Click="OnDuplicateClicked"/>
              <Button Content="Supprimer" ToolTip.Tip="Supprimer l'objet (Del)" 
                      Click="OnDeleteClicked"/>
              
              <Separator Margin="5,0"/>
              
              <Button Content="Aligner X" ToolTip.Tip="Aligner sur l'axe X" 
                      Click="OnAlignXClicked"/>
              <Button Content="Aligner Y" ToolTip.Tip="Aligner sur l'axe Y" 
                      Click="OnAlignYClicked"/>
              
              <Separator Margin="5,0"/>
              
              <ToggleButton Content="Grille" ToolTip.Tip="Afficher/Masquer la grille" 
                            x:Name="GridToggle"/>
              <TextBox Text="10" Width="40" ToolTip.Tip="Taille de la grille"/>
              <ToggleButton Content="Snap" ToolTip.Tip="Activer/Désactiver le snap" 
                            x:Name="SnapToggle" IsChecked="True"/>
            </StackPanel>
          </Border>
          
          <editeur:GameViewHost Grid.Row="1"/>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="5" Background="Gray"
                    ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

      <!-- Console -->
      <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" x:Name="ConsolePanel" BorderBrush="Gray" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBox Grid.Row="0" x:Name="ConsoleOutput"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Background="Black"
                   Foreground="White"
                   FontFamily="Consolas"
                   Margin="5" />

          <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="ConsoleInput" Height="30" VerticalAlignment="Center"
                     KeyDown="OnConsoleInputKeyDown"
                     FontFamily="Consolas" Margin="0,0,5,0" />

            <Button Grid.Column="1" Content="▶" Width="40" Click="OnExecuteButtonClick" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>